<?xml version="1.0" encoding="utf-8"?>

<robot name="rm_gimbal" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- ========== 参数配置 ========== -->
  <!-- 相机相对云台的安装位置（由 launch 通过 camera_xyz / camera_rpy 注入） -->
  <xacro:arg name="camera_xyz" default="0.10 0 0.05" />
  <xacro:arg name="camera_rpy" default="0 0 0" />

  <!-- ========== 颜色/外观定义（用于 RViz 可视化） ========== -->
  <material name="camera_material">
    <color rgba="0.2 0.2 0.6 1.0"/>  <!-- 深蓝色 -->
  </material>

  <material name="gimbal_material">
    <color rgba="0.9 0.5 0.1 1.0"/>  <!-- 橙色 -->
  </material>

  <!-- ========== 连杆定义 ========== -->

  <!-- 1. 里程计/世界坐标系 -->
  <link name="odom"/>

  <!-- 2. 云台连杆（其位姿由串口驱动动态广播 odom -> gimbal_link） -->
  <link name="gimbal_link">
    <visual>
      <geometry>
        <box size="0.12 0.06 0.08"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="gimbal_material"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.12 0.06 0.08"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
    </inertial>
  </link>

  <!-- 3. 相机连杆 -->
  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.05 0.03 0.03"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="camera_material"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.05 0.03 0.03"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <!-- 4. 相机光学坐标系（遵循 REP 103 / REP 104 标准） -->
  <link name="camera_optical_frame">
    <visual>
      <geometry>
        <box size="0.001 0.001 0.001"/>
      </geometry>
    </visual>
  </link>

  <!-- ========== 关节定义 ========== -->

  <!-- 云台浮动关节：odom -> gimbal_link（robot_state_publisher 不发布浮动关节，
       该位姿由串口驱动按电控回传的 roll/pitch/yaw 动态广播） -->
  <joint name="gimbal_joint" type="floating">
    <parent link="odom"/>
    <child link="gimbal_link"/>
  </joint>

  <!-- 相机固定连接：gimbal_link -> camera_link（安装外参在此注入） -->
  <joint name="camera_joint" type="fixed">
    <origin xyz="$(arg camera_xyz)" rpy="$(arg camera_rpy)"/>
    <parent link="gimbal_link"/>
    <child link="camera_link"/>
  </joint>

  <!-- 相机光学坐标系转换 -->
  <joint name="camera_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
  </joint>

</robot>
